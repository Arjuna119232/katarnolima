{
  "appId": "com.katarnolima.rw05",
  "appName": "KATARNOLIMA RW05",
  "webDir": "www",
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Camera": {
      "permissions": [
        "camera",
        "photos"
      ]
    },
    "Geolocation": {
      "permissions": [
        "location"
      ]
    }
  },
  "android": {
    "zoomEnabled": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0a0f1a",
    "allowMixedContent": false,
    "captureInput": true
  }
}
